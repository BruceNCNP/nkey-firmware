if(NOT DEFINED OUT)
    message(FATAL_ERROR "OUT is required")
endif()

string(TIMESTAMP hour "%H")
string(TIMESTAMP minute "%M")
string(REGEX REPLACE "^0+" "" hour "${hour}")
string(REGEX REPLACE "^0+" "" minute "${minute}")
if(hour STREQUAL "")
    set(hour 0)
endif()
if(minute STREQUAL "")
    set(minute 0)
endif()
math(EXPR NKEY_BUILD_PATCH "${hour} * 100 + ${minute}")
file(WRITE "${OUT}" "#define NKEY_BUILD_PATCH ${NKEY_BUILD_PATCH}u\n")
